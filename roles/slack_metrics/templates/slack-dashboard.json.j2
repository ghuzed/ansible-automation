{# Grafana dashboard: a gauge of the members against slack_metrics_member_limit,
   orange from slack_metrics_member_warning (80% of it, rounded to the tens) #}
{
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Active, non-guest, human members. The Slack for Nonprofits free Pro plan covers workspaces of {{ slack_metrics_member_limit }} or fewer members.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": {{ slack_metrics_member_warning }}
              },
              {
                "color": "red",
                "value": {{ slack_metrics_member_limit }}
              }
            ]
          },
          "decimals": 0,
          "unit": "none",
          "min": 0,
          "max": {{ slack_metrics_member_limit }}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(slack_workspace_members{type=\"full\"}[2h]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Slack Members",
      "type": "gauge"
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "slack"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "title": "Slack",
  "uid": "slack-members"
}
